{
  "name": "yoplai",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @yoplai/shared --filter @yoplai/extension-irc --filter @yoplai/extension-heartbeat --filter @yoplai/extension-scheduler --filter @yoplai/extension-langfuse --filter @yoplai/extension-multi-user --filter @yoplai/extension-discord --filter @yoplai/extension-slack --filter @yoplai/extension-telegram --filter @yoplai/extension-webhooks --filter @yoplai/extension-projects --filter @yoplai/extension-board --filter @yoplai/extension-subagents --filter @yoplai/extension-orchestrator --filter @yoplai/gateway --filter @yoplai/agent-runner build",
    "build:web": "pnpm --filter @yoplai/web build",
    "dev": "pnpm exec tsx scripts/dev.ts",
    "dev:gateway": "pnpm --filter @yoplai/shared exec tsc --watch --preserveWatchOutput & NODE_OPTIONS='--conditions=development' YOPLAI_WEB_DEV=1 pnpm --filter @yoplai/gateway exec tsx watch --include '../../packages/shared/dist/**/*' src/cli/index.ts gateway",
    "dev:web": "pnpm --filter @yoplai/web dev",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:web": "vitest run --dir apps/web/src",
    "test:gateway": "vitest run --dir apps/gateway/src",
    "test:shared": "vitest run --dir packages/shared/src",
    "test:cli": "vitest run --dir packages/extensions/projects/src/cli",
    "yoplai": "node apps/gateway/dist/cli/index.js",
    "yoplai:dev": "tsx apps/gateway/src/cli/index.ts",
    "subagent": "pnpm --filter @yoplai/gateway exec tsx src/cli/subagent.ts",
    "init-dev-config": "node scripts/create-local-config.js",
    "update-models": "tsx scripts/update-models.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@solidjs/router": "^0.15.4",
    "@types/node": "^22.19.6",
    "eslint": "^9.39.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.0",
    "solid-js": "^1.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "engines": {
    "node": ">=22.19.0"
  }
}
